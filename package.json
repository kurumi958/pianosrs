{
  "name": "pianosrs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node electron/dev.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xmldom/xmldom": "^0.8.10",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.56.0",
    "opensheetmusicdisplay": "^2.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "typescript": "~5.9.0",
    "vexflow": "^4.2.5",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "description": "Spaced-repetition sight-reading practice with a MIDI piano",
  "author": "PianoSRS",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.pianosrs.desktop",
    "productName": "PianoSRS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "PianoSRS-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PianoSRS-${version}-windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PianoSRS-${version}-windows-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education"
    }
  }
}
